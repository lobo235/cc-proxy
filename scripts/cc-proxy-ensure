#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

HOST="${CC_PROXY_HOST:-127.0.0.1}"
PORT="${CC_PROXY_PORT:-${PORT:-18765}}"
BASE_URL="${CC_PROXY_BASE_URL:-http://$HOST:$PORT}"
HEALTH_URL="${BASE_URL%/}/healthz"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cc-proxy"
PID_FILE="$STATE_DIR/cc-proxy.pid"
LOG_FILE="$STATE_DIR/cc-proxy.log"
PROXY_BIN="$REPO_ROOT/bin/cc-proxy"

is_healthy() {
	curl -fsS --max-time 1 "$HEALTH_URL" >/dev/null 2>&1
}

is_pid_alive() {
	local pid="${1:-}"
	[[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1
}

wait_for_health() {
	local i
	for i in {1..40}; do
		if is_healthy; then
			return 0
		fi
		sleep 0.25
	done
	return 1
}

mkdir -p "$STATE_DIR"

if is_healthy; then
	exit 0
fi

if [[ -f "$PID_FILE" ]]; then
	pid="$(<"$PID_FILE")"
	if is_pid_alive "$pid"; then
		if wait_for_health; then
			exit 0
		fi
		echo "cc-proxy process $pid is running but $HEALTH_URL did not become healthy." >&2
		echo "See $LOG_FILE for details." >&2
		exit 1
	fi
	rm -f "$PID_FILE"
fi

if [[ ! -x "$PROXY_BIN" ]]; then
	( cd "$REPO_ROOT" && make build >/dev/null )
fi

(
	cd "$REPO_ROOT"
	PORT="$PORT" nohup "$PROXY_BIN" serve >>"$LOG_FILE" 2>&1 &
	echo "$!" >"$PID_FILE"
)

if wait_for_health; then
	exit 0
fi

echo "cc-proxy did not become healthy at $HEALTH_URL." >&2
echo "See $LOG_FILE for details." >&2
exit 1
