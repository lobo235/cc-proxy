#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

HOST="${CC_PROXY_HOST:-127.0.0.1}"
PORT="${CC_PROXY_PORT:-${PORT:-18765}}"
BASE_URL="${CC_PROXY_BASE_URL:-http://$HOST:$PORT}"
API_KEY="${CC_PROXY_ANTHROPIC_API_KEY:-cc-proxy}"
MODEL="${CLAUDE_GPT_MODEL:-gpt-5.5[1m]}"
SMALL_FAST_MODEL="${CLAUDE_GPT_SMALL_FAST_MODEL:-gpt-5.4-mini[1m]}"
LEAN_DEFAULT="${CLAUDE_GPT_LEAN:-0}"
CACHE_KEY_STRATEGY="${CLAUDE_GPT_CACHE_KEY_STRATEGY:-${CCP_CODEX_CACHE_KEY_STRATEGY:-}}"

is_truthy() {
	case "${1,,}" in
		1 | true | yes | on) return 0 ;;
		*) return 1 ;;
	esac
}

strip_context_suffix() {
	local model="$1"
	case "$model" in
		*"[1m]" | *"[1M]") model="${model%????}" ;;
	esac
	printf '%s' "$model"
}

if [[ -n "${CLAUDE_GPT_TOOLS+x}" ]]; then
	DEFAULT_TOOLS="$CLAUDE_GPT_TOOLS"
elif is_truthy "$LEAN_DEFAULT"; then
	DEFAULT_TOOLS="Bash,Edit,MultiEdit,Read,Write,Grep,Glob,LS,TodoWrite"
else
	DEFAULT_TOOLS=""
fi

has_flag() {
	local needle="$1"
	local arg
	for arg in "${args[@]}"; do
		case "$arg" in
			"$needle" | "$needle"=*) return 0 ;;
		esac
	done
	return 1
}

has_model=0
REQUESTED_MODEL="$MODEL"
args=("$@")
for i in "${!args[@]}"; do
	arg="${args[$i]}"
	case "$arg" in
		--model)
			has_model=1
			next_index=$((i + 1))
			if [[ "$next_index" -lt "${#args[@]}" ]]; then
				REQUESTED_MODEL="${args[$next_index]}"
			fi
			break
			;;
		--model=*)
			has_model=1
			REQUESTED_MODEL="${arg#--model=}"
			break
			;;
	esac
done

claude_args=()
if is_truthy "${CLAUDE_GPT_BARE:-$LEAN_DEFAULT}" && ! has_flag "--bare"; then
	claude_args+=(--bare)
fi
if is_truthy "${CLAUDE_GPT_STRICT_MCP_CONFIG:-$LEAN_DEFAULT}" && ! has_flag "--strict-mcp-config"; then
	claude_args+=(--strict-mcp-config)
fi
if is_truthy "${CLAUDE_GPT_DISABLE_SLASH_COMMANDS:-0}" && ! has_flag "--disable-slash-commands"; then
	claude_args+=(--disable-slash-commands)
fi
if [[ -n "$DEFAULT_TOOLS" ]] && ! has_flag "--tools"; then
	claude_args+=(--tools "$DEFAULT_TOOLS")
fi
if [[ "$has_model" -eq 0 ]]; then
	claude_args+=(--model "$MODEL")
fi
claude_args+=("$@")
PROXY_MODEL="$(strip_context_suffix "$REQUESTED_MODEL")"

if is_truthy "${CLAUDE_GPT_DRY_RUN:-0}"; then
	printf 'CCP_CODEX_MODEL=%q ' "${CCP_CODEX_MODEL:-$PROXY_MODEL}"
	if [[ -n "$CACHE_KEY_STRATEGY" ]]; then
		printf 'CCP_CODEX_CACHE_KEY_STRATEGY=%q ' "$CACHE_KEY_STRATEGY"
	fi
	printf 'ANTHROPIC_BASE_URL=%q ANTHROPIC_API_KEY=%q ' "$BASE_URL" "$API_KEY"
	printf 'ANTHROPIC_SMALL_FAST_MODEL=%q ' "${ANTHROPIC_SMALL_FAST_MODEL:-$SMALL_FAST_MODEL}"
	printf 'CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=%q ' "${CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:-1}"
	printf 'CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=%q claude' "${CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK:-1}"
	printf ' %q' "${claude_args[@]}"
	printf '\n'
	exit 0
fi

ensure_env=(CCP_CODEX_MODEL="${CCP_CODEX_MODEL:-$PROXY_MODEL}")
if [[ -n "$CACHE_KEY_STRATEGY" ]]; then
	ensure_env+=(CCP_CODEX_CACHE_KEY_STRATEGY="$CACHE_KEY_STRATEGY")
fi
if is_truthy "${CLAUDE_GPT_PROXY_VERBOSE:-1}"; then
	ensure_env+=(CCP_LOG_VERBOSE=1)
fi
env "${ensure_env[@]}" "$SCRIPT_DIR/cc-proxy-ensure" >/dev/null

exec env \
	ANTHROPIC_BASE_URL="$BASE_URL" \
	ANTHROPIC_API_KEY="$API_KEY" \
	ANTHROPIC_SMALL_FAST_MODEL="${ANTHROPIC_SMALL_FAST_MODEL:-$SMALL_FAST_MODEL}" \
	CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="${CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:-1}" \
	CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK="${CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK:-1}" \
	claude "${claude_args[@]}"
